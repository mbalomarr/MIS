@{
    var columns = new (string Heading, (string Label, string Href, bool External)[] Links)[]
    {
        ("Academic Hub", new[]
        {
            ("The Major", "/#academic-hub", false),
            ("PMU Website", SiteContent.UniversityUrl, true),
        }),
        ("MIS Club", new[]
        {
            ("Activities", "/#mis-club", false),
            ("Join Us", "/join", false),
        }),
        ("Build", new[]
        {
            ("Tech Projects", "/#projects", false),
            ("Source on GitHub", SiteContent.GithubRepo, true),
        }),
    };
}
<footer class="bg-ink-900 pt-16 text-ink-300">
    <div class="container-site grid gap-12 pb-12 lg:grid-cols-[1fr_1.3fr]">
        @* Brand + contact *@
        <div>
            <img src="~/brand/03-horizontal-dark-transparent.svg" alt="@SiteContent.ClubName — @SiteContent.UniversityShort" width="260" height="92" class="h-auto w-56" loading="lazy" />
            <p class="mt-3 text-xs tracking-[0.14em] text-signal-300 uppercase">@SiteContent.University</p>
            <p class="mt-4 max-w-sm text-sm">The hub for the Management Information Systems major and the official website of the MIS Student Club.</p>

            <address class="mt-6 grid gap-3 text-sm not-italic">
                <a href="mailto:@SiteContent.Email" class="inline-flex items-center gap-3 transition-colors hover:text-signal-300">
                    <i data-lucide="mail" class="size-[18px] shrink-0 text-signal-500" aria-hidden="true"></i>@SiteContent.Email
                </a>
                <span class="inline-flex items-center gap-3">
                    <i data-lucide="map-pin" class="size-[18px] shrink-0 text-signal-500" aria-hidden="true"></i>@SiteContent.Location
                </span>
            </address>

            <ul class="mt-6 flex gap-2" aria-label="Social links">
                <li>
                    <a href="@SiteContent.GithubRepo" target="_blank" rel="noopener noreferrer"
                       class="grid size-10 place-items-center rounded-full border border-paper/15 text-paper transition hover:-translate-y-0.5 hover:border-signal-300 hover:text-signal-300">
                        <partial name="_GitHubIcon" model="@("size-[18px]")" />
                        <span class="sr-only">GitHub (opens in a new tab)</span>
                    </a>
                </li>
                <li>
                    <a href="@SiteContent.Instagram" target="_blank" rel="noopener noreferrer"
                       class="grid size-10 place-items-center rounded-full border border-paper/15 text-paper transition hover:-translate-y-0.5 hover:border-signal-300 hover:text-signal-300">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true" focusable="false">
                            <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                        <span class="sr-only">Instagram (opens in a new tab)</span>
                    </a>
                </li>
            </ul>
        </div>

        @* Link columns *@
        <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3">
            @foreach (var (heading, links) in columns)
            {
                <div>
                    <h2 class="mb-3 text-sm tracking-[0.12em] text-white uppercase">@heading</h2>
                    <ul class="grid gap-2">
                        @foreach (var (label, href, external) in links)
                        {
                            <li>
                                @if (external)
                                {
                                    <a href="@href" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm transition-colors hover:text-signal-300">
                                        @label <i data-lucide="external-link" class="size-3" aria-hidden="true"></i><span class="sr-only">(opens in a new tab)</span>
                                    </a>
                                }
                                else
                                {
                                    <a href="@href" class="text-sm transition-colors hover:text-signal-300">@label</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>
    </div>

    <div class="border-t border-paper/10">
        <div class="container-site flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4 text-xs">
            <p>&copy; @DateTime.UtcNow.Year @SiteContent.ClubName — @SiteContent.University. All rights reserved.</p>
            <a href="@SiteContent.GithubRepo" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-mono transition-colors hover:text-signal-300">
                <partial name="_GitHubIcon" model="@("size-4")" />
                @SiteContent.GithubRepo.Replace("https://", "")
                <span class="sr-only">(opens in a new tab)</span>
            </a>
            <a href="#top" class="inline-flex items-center gap-1 transition-colors hover:text-signal-300">
                Back to top <i data-lucide="arrow-up" class="size-3.5" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</footer>
