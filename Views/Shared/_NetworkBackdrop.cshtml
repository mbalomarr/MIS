@model string
@* Decorative grid + glowing node network from the original hero. Model = id prefix (keeps SVG ids unique). *@
@{
    var nodes = new (int X, int Y, int R)[]
    {
        (180, 520, 5), (340, 380, 4), (520, 440, 6), (700, 260, 4), (900, 320, 5),
        (1040, 180, 4), (300, 180, 5), (640, 600, 4), (880, 560, 5),
    };
    var delays = new[] { "0s", "0.8s", "1.6s" };
}
<svg class="pointer-events-none absolute inset-0 size-full" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
        <pattern id="@(Model)-grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M60 0H0V60" fill="none" stroke="#2FB8C6" stroke-width="0.5" opacity="0.18" />
        </pattern>
        <radialGradient id="@(Model)-fade" cx="50%" cy="40%" r="70%">
            <stop offset="0%" stop-color="#fff" stop-opacity="1" />
            <stop offset="100%" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <mask id="@(Model)-mask">
            <rect width="1200" height="700" fill="url(#@(Model)-fade)" />
        </mask>
    </defs>
    <rect width="1200" height="700" fill="url(#@(Model)-grid)" mask="url(#@(Model)-mask)" />
    <g stroke="#2FB8C6" stroke-width="1" opacity="0.16" fill="none">
        <path d="M180 520 L340 380 L520 440 L700 260 L900 320 L1040 180" />
        <path d="M120 240 L300 180 L520 440 L640 600 L880 560 L1060 470" />
    </g>
    <g fill="#2FB8C6">
        @for (var i = 0; i < nodes.Length; i++)
        {
            <circle cx="@nodes[i].X" cy="@nodes[i].Y" r="@nodes[i].R" class="animate-node-glow" style="animation-delay: @delays[i % delays.Length]" />
        }
    </g>
</svg>
