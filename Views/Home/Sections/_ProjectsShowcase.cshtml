<section id="projects" aria-labelledby="projects-title" class="relative overflow-hidden bg-ink-900 py-16 text-paper sm:py-24">
    <div class="opacity-40"><partial name="_NetworkBackdrop" model="@("projects")" /></div>

    <div class="container-site relative">
        <header class="mb-12 flex flex-wrap items-end justify-between gap-6 lg:mb-16">
            <div class="max-w-3xl">
                <p class="mb-3 text-sm font-medium tracking-[0.18em] text-signal-300 uppercase">Open Source</p>
                <h2 id="projects-title" class="text-3xl text-white sm:text-4xl lg:text-[2.5rem]">We build in the open.</h2>
                <p class="mt-4 text-[1.0625rem] text-ink-300">
                    Club projects live on GitHub — read the code, open an issue, or send a pull request. Every contribution is a portfolio piece.
                </p>
            </div>
            <a href="@SiteContent.GithubRepo" target="_blank" rel="noopener noreferrer"
               class="inline-flex shrink-0 items-center gap-2 rounded-full border border-paper/35 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-paper/10">
                <partial name="_GitHubIcon" model="@("size-[18px]")" />
                View on GitHub <span class="sr-only">(opens in a new tab)</span>
            </a>
        </header>

        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var project in SiteContent.Projects)
            {
                var isLive = project.Status == "Live";
                <li>
                    <article class="flex h-full flex-col overflow-hidden rounded-panel border border-paper/10 bg-ink-700/40 transition duration-300 hover:-translate-y-1 hover:border-signal-500/50 hover:shadow-float">
                        <header class="flex items-center justify-between gap-3 border-b border-paper/10 bg-ink-900/60 px-6 py-4">
                            <span class="flex min-w-0 items-center gap-2 font-mono text-sm text-ink-300">
                                <partial name="_GitHubIcon" model="@("size-[18px] shrink-0 text-white")" />
                                <span class="truncate">@(project.RepoUrl?.Replace("https://github.com/", "") ?? "coming soon")</span>
                            </span>
                            <span class="rounded-full px-2.5 py-1 text-xs font-semibold tracking-[0.06em] uppercase @(isLive ? "bg-success/15 text-[#4fd1a0]" : "bg-paper/10 text-ink-300")">@project.Status</span>
                        </header>
                        <div class="flex flex-1 flex-col p-6">
                            <h3 class="mb-3 text-xl text-white">@project.Title</h3>
                            <p class="mb-6 flex-1 text-sm text-ink-300">@project.Description</p>
                            <ul class="mb-6 flex flex-wrap gap-2" aria-label="Tech stack">
                                @foreach (var tech in project.Stack)
                                {
                                    <li class="rounded-full border border-paper/15 bg-paper/5 px-2.5 py-1 font-mono text-xs text-ink-300">@tech</li>
                                }
                            </ul>
                            <a href="@(project.RepoUrl ?? SiteContent.GithubRepo)" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-1.5 self-end border-t border-paper/10 pt-5 text-sm font-semibold text-signal-300 transition-colors hover:text-white">
                                @(project.RepoUrl is null ? "Follow progress" : "View code")
                                <i data-lucide="arrow-up-right" class="size-4" aria-hidden="true"></i>
                                <span class="sr-only">: @project.Title on GitHub (opens in a new tab)</span>
                            </a>
                        </div>
                    </article>
                </li>
            }
        </ul>
    </div>
</section>
